{
  "name": "dentix-booking-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --host 127.0.0.1 --port 4180",
    "build": "npm run build:preview",
    "build:preview": "node ./node_modules/typescript/bin/tsc --noEmit && node --experimental-strip-types ./scripts/build.mjs preview",
    "build:production": "node ./node_modules/typescript/bin/tsc --noEmit && node --experimental-strip-types ./scripts/build.mjs production",
    "preview": "node --experimental-strip-types ./scripts/serve-artifact.mjs preview 4181",
    "preview:production": "node --experimental-strip-types ./scripts/serve-artifact.mjs production 4182",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:artifacts": "node --experimental-strip-types --test tests/artifacts.test.mjs",
    "test:browser": "node --experimental-strip-types tests/technical-browser.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.8.3",
    "vite": "^8.1.5"
  }
}
