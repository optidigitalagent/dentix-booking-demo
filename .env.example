# This public demo has no runtime credentials and no production endpoints.
VITE_DENTIX_DEMO_MODE=true

# Public Google Apps Script Web App JSON endpoint. This is not a credential.
VITE_DENTIX_CONTENT_API_URL=
VITE_DENTIX_CONTENT_TIMEOUT_MS=4000

# Railway lead endpoint; public demo accepts clearly marked fictional TEST data only.
VITE_DENTIX_LEADS_API_URL=
VITE_DENTIX_LEAD_TEST_MODE=true
VITE_DENTIX_PRIVACY_POLICY_URL=
VITE_DENTIX_LEAD_CONTACT_METHODS=PHONE,TELEGRAM,VIBER,WHATSAPP
